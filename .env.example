# Server-side proxy used by the display content editor. Defaults to the
# built-in /api/display-images route via the meta tag in index.html — only
# set this if pointing at a different image endpoint.
# Provider API keys must remain on the server and never be placed here.
VITE_SWISSCOMPACT_IMAGE_API_URL=
# Optional, defaults to gpt-image-2. Server-only, powers the portal image studio
# and /api/display-images.
OPENAI_IMAGE_MODEL=
# Optional, defaults to "medium" — a deliberate cost control (OpenAI's
# unset default is its most expensive tier). "low" | "medium" | "high".
OPENAI_IMAGE_QUALITY=

# Kundenportal: KI-Credit-Käufe über Stripe Checkout. Ausschliesslich serverseitig.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Skalierbare Videoaufbereitung über Mux. Erst aktivieren, wenn alle fünf
# Geheimnisse in derselben Vercel-Umgebung gesetzt und der Webhook auf
# https://www.swisscompact.com/api/dashboard/records?integration=mux-webhook eingerichtet ist.
MUX_VIDEO_ENABLED=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-kodierter private_key aus Mux (niemals mit VITE_ präfixen).
MUX_PRIVATE_KEY=

# Sales assistant (api/assistant/*) — server-only, see docs/sales-assistant.md
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=
# Optional, defaults to "medium" — how much the model "thinks" before
# replying. Raised from the original "low" after live-testing showed the
# model needed more budget to reliably act on newer capabilities (e.g.
# placing displays) alongside its existing rules, not just talk about
# them. "minimal" | "low" | "medium" | "high" (higher = more reliable,
# more cost/latency per message).
OPENAI_ASSISTANT_REASONING_EFFORT=
OPENAI_ASSISTANT_TTS_MODEL=
OPENAI_ASSISTANT_VOICE=
OPENAI_ASSISTANT_REALTIME_MODEL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard Face ID/passkey login (src/dashboard/passkeyClient.ts) needs a
# browser-side Supabase client, which can only use the public anon key —
# never the service role key. Vite only inlines VITE_-prefixed vars into
# the client bundle, so these are intentionally separate from the
# server-only vars above. Both are safe to expose in the browser: the
# anon key is meant to be public, and RLS policies are what actually gate
# access, same as any Supabase browser client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Lead delivery needs at least Supabase or Resend. Configure both for
# redundant CRM storage plus internal/customer email notifications.
RESEND_API_KEY=
SITE_URL=
