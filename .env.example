# Server-side proxy used by the display content editor. Defaults to the
# built-in /api/display-images route via the meta tag in index.html — only
# set this if pointing at a different image endpoint.
# Provider API keys must remain on the server and never be placed here.
VITE_SWISSCOMPACT_IMAGE_API_URL=
# Optional, defaults to gpt-image-1. Server-only, powers /api/display-images.
OPENAI_IMAGE_MODEL=

# Sales assistant (api/assistant/*) — server-only, see docs/sales-assistant.md
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=
OPENAI_ASSISTANT_TTS_MODEL=
OPENAI_ASSISTANT_VOICE=
OPENAI_ASSISTANT_REALTIME_MODEL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
SITE_URL=
