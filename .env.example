# Server-side proxy used by the display content editor. Defaults to the
# built-in /api/display-images route via the meta tag in index.html — only
# set this if pointing at a different image endpoint.
# Provider API keys must remain on the server and never be placed here.
VITE_SWISSCOMPACT_IMAGE_API_URL=
# Optional, defaults to gpt-image-1. Server-only, powers /api/display-images.
OPENAI_IMAGE_MODEL=
# Optional, defaults to "medium" — a deliberate cost control (OpenAI's
# unset default is its most expensive tier). "low" | "medium" | "high".
OPENAI_IMAGE_QUALITY=

# Sales assistant (api/assistant/*) — server-only, see docs/sales-assistant.md
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=
# Optional, defaults to "medium" — how much the model "thinks" before
# replying. Raised from the original "low" after live-testing showed the
# model needed more budget to reliably act on newer capabilities (e.g.
# placing displays) alongside its existing rules, not just talk about
# them. "minimal" | "low" | "medium" | "high" (higher = more reliable,
# more cost/latency per message).
OPENAI_ASSISTANT_REASONING_EFFORT=
OPENAI_ASSISTANT_TTS_MODEL=
OPENAI_ASSISTANT_VOICE=
OPENAI_ASSISTANT_REALTIME_MODEL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Lead delivery needs at least Supabase or Resend. Configure both for
# redundant CRM storage plus internal/customer email notifications.
RESEND_API_KEY=
SITE_URL=
